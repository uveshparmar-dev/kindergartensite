mod.wizards.newContentElement.wizardItems.common{
      header = LLL:EXT:kindergartensitepackage/Resources/Private/Language/locallang_db.xlf:n2telement
    elements {
        n2tgallerysection {
            iconIdentifier = content-text
            title = LLL:EXT:kindergartensitepackage/Resources/Private/Language/locallang_db.xlf:kindergartensitepackage.n2tgallerysection
            description = LLL:EXT:kindergartensitepackage/Resources/Private/Language/locallang_db.xlf:kindergartensitepackage.n2tgallerysection.description
            tt_content_defValues {
                CType = n2tgallerysection
            }
        }
    }
    show := addToList(n2tgallerysection)
}



# Backend preview
mod.web_layout.tt_content{
    preview {
         n2tgallerysection = EXT:kindergartensitepackage/Resources/Private/ContentElements/Templates/Preview/N2tGallerysection.html
    }
}

