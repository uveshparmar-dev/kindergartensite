mod.wizards.newContentElement.wizardItems.common{
      header = LLL:EXT:kindergartensitepackage/Resources/Private/Language/locallang_db.xlf:n2telement
    elements {
        n2tctasection {
            iconIdentifier = content-text
            title = LLL:EXT:kindergartensitepackage/Resources/Private/Language/locallang_db.xlf:kindergartensitepackage.n2tctasection
            description = LLL:EXT:kindergartensitepackage/Resources/Private/Language/locallang_db.xlf:kindergartensitepackage.n2tctasection.description
            tt_content_defValues {
                CType = n2tctasection
            }
        }
    }
    show := addToList(n2tctasection)
}



# Backend preview
mod.web_layout.tt_content{
    preview {
         n2tctasection = EXT:kindergartensitepackage/Resources/Private/ContentElements/Templates/Preview/N2tCtasection.html
    }
}

