mod.wizards.newContentElement.wizardItems.common{
      header = LLL:EXT:kindergartensitepackage/Resources/Private/Language/locallang_db.xlf:n2telement
    elements {
        n2taboutus {
            iconIdentifier = content-text
            title = LLL:EXT:kindergartensitepackage/Resources/Private/Language/locallang_db.xlf:kindergartensitepackage.n2taboutus
            description = LLL:EXT:kindergartensitepackage/Resources/Private/Language/locallang_db.xlf:kindergartensitepackage.n2taboutus.description
            tt_content_defValues {
                CType = n2taboutus
            }
        }
    }
    show := addToList(n2taboutus)
}



# Backend preview
mod.web_layout.tt_content{
    preview {
         n2taboutus = EXT:kindergartensitepackage/Resources/Private/ContentElements/Templates/Preview/N2tAboutus.html
    }
}

