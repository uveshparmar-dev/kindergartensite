plugin.tx_form {
  view {
    templateRootPaths {
   
      100 = EXT:kindergartensitepackage/Resources/Private/Extensions/Form/Templates/
    }

    partialRootPaths {
     
      100 = EXT:kindergartensitepackage/Resources/Private/Extensions/Form/Partials/
    }

    layoutRootPaths {
 
      100 = EXT:kindergartensitepackage/Resources/Private/Extensions/Form/Layouts/
    }
  }
}


plugin.tx_form {
  settings {
    yamlConfigurations {
      100 = EXT:kindergartensitepackage/Configuration/Form/Setup.yaml
    }
  }
}
